-- start_matchsubs
-- m/{QUERY .* (false|true)}\{/
-- s/{QUERY .* (false|true)}\{/{QUERY...}{/
-- m/}\{r \d+ /
-- s/}\{r \d+ /}{r XXXX /
-- m/}\{f \d+ /
-- s/}\{f \d+ /}{f XXXX /
-- m/{QUERY .* (false|true)}",/
-- s/{QUERY .* (false|true)}",/{QUERY...}",/
-- m/{QUERY .* (false|true)},<none>/
-- s/{QUERY .* (false|true)},<none>/{QUERY...},<none>/
-- m/pg_temp_\d+/
-- s/pg_temp_\d+/pg_temp_XX/
-- end_matchsubs
\set VERBOSITY terse

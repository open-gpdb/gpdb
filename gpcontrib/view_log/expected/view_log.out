SELECT loguser, logsession, viewname
FROM show_view_log_simple(:'before_query')
WHERE viewname IS NOT NULL;
 loguser | logsession |    viewname    
---------+------------+----------------
 userXXX | conXXX     | public.my_view
(1 row)

